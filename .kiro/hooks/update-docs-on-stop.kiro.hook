{
  "enabled": true,
  "name": "Update Developer Guide",
  "description": "After each agent session completes, remind the agent to update docs/DEVELOPER_GUIDE.md with any changes made during the session",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Review the changes made in this session and update docs/DEVELOPER_GUIDE.md to reflect them. Focus on: new/renamed files, changed function signatures, new API routes, infrastructure changes, new environment variables, and any design decisions made. Keep it concise and accurate."
  }
}